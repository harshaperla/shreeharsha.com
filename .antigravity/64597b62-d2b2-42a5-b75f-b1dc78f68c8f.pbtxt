    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Menu, X, Code2, BookOpen, Map, Mail, User } from \'lucide-react\';\nimport { SHREEHARSHA_BIO } from \'../data\';\n\ninterface NavigationProps {\n  activeSection: string;\n  setActiveSection: (sec: string) => void;\n  mobileMenuOpen: boolean;\n  setMobileMenuOpen: (open: boolean) => void;\n}\n\nexport default function Navigation({\n  activeSection,\n  setActiveSection,\n  mobileMenuOpen,\n  setMobileMenuOpen,\n}: NavigationProps) {\n  const navItems = [\n    { id: \'profile\', label: \'Profile\', icon: User },\n    { id: \'tech\', label: \'Tech Blog\', icon: Code2 },\n    { id: \'kannada\', label: \'\340\262\225\340\262\250\340\263\215\340\262\250\340\262\241 \340\262\254\340\263\215\340\262\262\340\262\276\340\262\227\340\263\215\', icon: BookOpen },\n    { id: \'travel\', label: \'Travel Blog\', icon: Map },\n    { id: \'contact\', label: \'Contact\', icon: Mail },\n  ];\n\n  return (\n    <header className=\"sticky top-0 z-50 bg-zinc-950/80 backdrop-blur-md border-b border-zinc-800/80 transition-all\">\n      <div className=\"max-w-6xl mx-auto px-4 md:px-6\">\n        <div className=\"flex items-center justify-between h-16\">\n          {/* Logo / Domain */}\n          <div \n            onClick={() => setActiveSection(\'profile\')}\n            className=\"flex items-center space-x-2 cursor-pointer group\"\n          >\n            <span className=\"font-mono text-zinc-400 group-hover:text-zinc-200 transition-colors\">\342\232\241</span>\n            <span className=\"font-sans font-bold text-zinc-100 tracking-tight group-hover:text-white transition-all text-lg\">\n              {SHREEHARSHA_BIO.domain}\n            </span>\n          </div>\n\n          {/* Large Screen Navigation Links */}\n          <nav className=\"hidden md:flex items-center space-x-1\">\n            {navItems.map((item) => {\n              const Icon = item.icon;\n              const isActive = activeSection === item.id;\n              return (\n                <button\n                  key={item.id}\n                  onClick={() => setActiveSection(item.id)}\n                  className={`flex items-center space-x-2 px-4 py-2 rounded-md font-sans text-sm font-medium transition-all duration-150 relative ${\n                    isActive\n                      ? \'text-white bg-zinc-900 border-b-2 border-zinc-50\'\n                      : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900/50\'\n                  }`}\n                  id={`nav-item-${item.id}`}\n                >\n                  <Icon className=\"w-4 h-4\" />\n                  <span>{item.label}</span>\n                </button>\n              );\n            })}\n          </nav>\n\n          {/* Mobile menu trigger */}\n          <div className=\"md:hidden flex items-center\">\n            <button\n              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n              className=\"text-zinc-400 hover:text-white p-2 focus:outline-none\"\n              aria-label=\"Toggle Menu\"\n              id=\"mobile-menu-toggle-btn\"\n            >\n              {mobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Mobile drop-down dropdown */}\n      {mobileMenuOpen && (\n        <div className=\"md:hidden bg-zinc-950 border-b border-zinc-800 px-4 pt-2 pb-4 space-y-1\">\n          {navItems.map((item) => {\n            const Icon = item.icon;\n            const isActive = activeSection === item.id;\n            return (\n              <button\n                key={item.id}\n                onClick={() => {\n                  setActiveSection(item.id);\n                  setMobileMenuOpen(false);\n                }}\n                className={`flex items-center space-x-3 w-full px-4 py-3 rounded-lg text-left font-sans text-base font-medium transition-colors ${\n                  isActive\n                    ? \'text-white bg-zinc-900 border-l-4 border-zinc-200\'\n                    : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900/40\'\n                }`}\n                id={`mobile-nav-item-${item.id}`}\n              >\n                <Icon className=\"w-5 h-5\" />\n                <span>{item.label}</span>\n              </button>\n            );\n          })}\n        </div>\n      )}\n    </header>\n  );\n}\n"
    }
