    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { Shield, Cpu, RefreshCw, ChevronRight, Layers, Award, Radio } from \'lucide-react\';\nimport { SHREEHARSHA_BIO, SYSTEM_MINDSETS, PROJECTS_DATABASE } from \'../data\';\n\ninterface ProfileSectionProps {\n  onNavigateToBlogs: (type: string) => void;\n  onNavigateToContact: () => void;\n}\n\nexport default function ProfileSection({ onNavigateToBlogs, onNavigateToContact }: ProfileSectionProps) {\n  // Stagger animation helpers\n  const containerVariants = {\n    hidden: { opacity: 0 },\n    show: {\n      opacity: 1,\n      transition: {\n        staggerChildren: 0.1,\n      },\n    },\n  };\n\n  const itemVariants = {\n    hidden: { opacity: 0, y: 15 },\n    show: { opacity: 1, y: 0, transition: { type: \'spring\', stiffness: 100 } },\n  };\n\n  return (\n    <motion.div\n      variants={containerVariants}\n      initial=\"hidden\"\n      animate=\"show\"\n      className=\"space-y-12 max-w-6xl mx-auto px-4 py-8 md:py-12\"\n      id=\"profile-section-container\"\n    >\n      {/* 2-Column Hero Structure */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        {/* Bio Highlights / Left Column */}\n        <motion.div variants={itemVariants} className=\"lg:col-span-7 space-y-6\">\n          <div className=\"inline-flex items-center space-x-2 bg-zinc-900 border border-zinc-800 px-3 py-1 rounded-full\">\n            <span className=\"w-2 h-2 bg-emerald-400 rounded-full animate-pulse\"></span>\n            <span className=\"font-mono text-xs text-zinc-400 tracking-wide uppercase\">Operational Architecture</span>\n          </div>\n\n          <h1 className=\"font-sans font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-[1.1]\">\n            I&apos;m <span className=\"text-zinc-50 font-mono tracking-normal\">{SHREEHARSHA_BIO.name}</span>.\n          </h1>\n\n          <p className=\"font-sans font-medium text-xl text-zinc-300 leading-relaxed max-w-2xl italic border-l-2 border-zinc-700 pl-4\">\n            &ldquo;{SHREEHARSHA_BIO.tagline}&rdquo;\n          </p>\n\n          <p className=\"font-sans text-base text-zinc-400 leading-relaxed max-w-2xl\">\n            {SHREEHARSHA_BIO.philosophy}\n          </p>\n\n          <div className=\"flex flex-wrap gap-4 pt-2\">\n            <button\n              onClick={onNavigateToContact}\n              className=\"bg-zinc-100 text-zinc-950 font-sans font-semibold text-sm px-6 py-3 rounded-lg hover:bg-white hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center space-x-2 cursor-pointer shadow-lg\"\n              id=\"hero-contact-btn\"\n            >\n              <span>Connect & Collaborate</span>\n              <ChevronRight className=\"w-4 h-4\" />\n            </button>\n            <button\n              onClick={() => onNavigateToBlogs(\'tech\')}\n              className=\"bg-zinc-900 text-zinc-300 border border-zinc-800 font-sans font-medium text-sm px-6 py-3 rounded-lg hover:text-white hover:bg-zinc-800/60 transition-all cursor-pointer\"\n              id=\"hero-tech-blog-btn\"\n            >\n              Read Tech Blog\n            </button>\n          </div>\n        </motion.div>\n\n        {/* Builder Mindset Card / Right Column */}\n        <motion.div variants={itemVariants} className=\"lg:col-span-5\">\n          <div className=\"bg-gradient-to-br from-zinc-900 to-zinc-950 border border-zinc-800 p-6 md:p-8 rounded-2xl relative overflow-hidden shadow-2xl\">\n            {/* Visual background grid */}\n            <div className=\"absolute inset-0 bg-[linear-gradient(to_right,#27272a_1px,transparent_1px),linear-gradient(to_bottom,#27272a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-30 pointer-events-none\" />\n\n            <div className=\"relative z-10 space-y-6\">\n              <h3 className=\"font-sans font-bold text-lg text-white border-b border-zinc-800 pb-3 flex items-center space-x-2\">\n                <Layers className=\"w-5 h-5 text-zinc-400\" />\n                <span>The Builder&apos;s Paradigm</span>\n              </h3>\n\n              <div className=\"space-y-4 font-mono text-xs text-zinc-400\">\n                <div className=\"flex justify-between py-1 border-b border-zinc-900\">\n                  <span className=\"text-zinc-500\">ENGINEERING STATUS</span>\n                  <span className=\"text-emerald-400 font-bold\">100% PRODUCTION-FIRST</span>\n                </div>\n                <div className=\"flex justify-between py-1 border-b border-zinc-900\">\n                  <span className=\"text-zinc-500\">OPERATIONAL MOTTO</span>\n                  <span className=\"text-zinc-200\">PROCESS IS SECOND TO RUNNING CODE</span>\n                </div>\n                <div className=\"flex justify-between py-1 border-b border-zinc-900\">\n                  <span className=\"text-zinc-500\">FAVORED ABSTRACTIONS</span>\n                  <span className=\"text-violet-400\">STATE MACHINES / PARSERS / DAGS</span>\n                </div>\n                <div className=\"flex justify-between py-1 border-b border-zinc-900\">\n                  <span className=\"text-zinc-500\">CURRENT DRIFT</span>\n                  <span className=\"text-zinc-200\">WORKFLOW AUTO \342\224\200\342\224\200> INTEL INFRA</span>\n                </div>\n              </div>\n\n              <div className=\"bg-zinc-950/60 p-4 border border-zinc-800/70 rounded-xl space-y-2\">\n                <span className=\"font-mono text-[10px] text-zinc-500 tracking-wider block uppercase\">Systems Synthesis Mindset</span>\n                <p className=\"font-sans text-sm text-zinc-300 leading-normal\">\n                  Refusing fuzzy heuristics. The architecture must always be mathematically sound before writing a single block of application code.\n                </p>\n              </div>\n            </div>\n          </div>\n        </motion.div>\n      </div>\n\n      {/* Structured Systems Section */}\n      <motion.div variants={itemVariants} className=\"space-y-6 border-t border-zinc-900 pt-10\">\n        <div>\n          <h2 className=\"font-sans font-bold text-2xl text-white tracking-tight\">Focus & Intersection</h2>\n          <p className=\"font-sans text-sm text-zinc-400\">The parameters that define my core engineering focus.</p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          {SYSTEM_MINDSETS.map((mindset, index) => (\n            <div\n              key={index}\n              className=\"bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700/80 p-5 rounded-xl hover:bg-zinc-900/60 transition-all duration-150 space-y-3\"\n            >\n              <div className=\"flex items-center space-x-3\">\n                <div className=\"bg-zinc-900 p-2.5 rounded-lg border border-zinc-800\">\n                  {index === 0 && <Shield className=\"w-5 h-5 text-sky-400\" />}\n                  {index === 1 && <Cpu className=\"w-5 h-5 text-amber-400\" />}\n                  {index === 2 && <RefreshCw className=\"w-5 h-5 text-emerald-400\" />}\n                </div>\n                <span className=\"font-mono text-xs text-zinc-500 uppercase tracking-widest\">{mindset.label}</span>\n              </div>\n              <h4 className=\"font-sans font-bold text-base text-zinc-100\">{mindset.value}</h4>\n              <p className=\"font-sans text-xs text-zinc-400 leading-relaxed\">{mindset.description}</p>\n            </div>\n          ))}\n        </div>\n      </motion.div>\n\n      {/* Production Case Studies Section (Real Products) */}\n      <motion.div variants={itemVariants} className=\"space-y-6 border-t border-zinc-900 pt-10\">\n        <div>\n          <h2 className=\"font-sans font-bold text-2xl text-white tracking-tight\">Engineered Architectures</h2>\n          <p className=\"font-sans text-sm text-zinc-400\">Core operational software products I have designed and deployed representing systemic logic over quick tricks.</p>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n          {PROJECTS_DATABASE.map((proj) => (\n            <div\n              key={proj.id}\n              className=\"bg-zinc-900/30 border border-zinc-800 hover:border-zinc-700 p-6 rounded-xl flex flex-col justify-between hover:bg-zinc-900/50 transition-all group\"\n            >\n              <div className=\"space-y-4\">\n                <div className=\"flex justify-between items-start\">\n                  <div>\n                    <span className=\"font-mono text-[10px] text-zinc-500 uppercase tracking-widest block\">{proj.type}</span>\n                    <h4 className=\"font-sans font-bold text-lg text-white group-hover:text-zinc-100 transition-colors mt-1\">\n                      {proj.title}\n                    </h4>\n                  </div>\n                  <span className=\"font-sans text-xs font-semibold px-2.5 py-1 rounded bg-zinc-800 text-zinc-300\">\n                    {proj.role}\n                  </span>\n                </div>\n\n                <p className=\"font-sans text-xs text-zinc-400 leading-relaxed line-clamp-4\">\n                  {proj.description}\n                </p>\n              </div>\n\n              <div className=\"mt-6 pt-4 border-t border-zinc-900 space-y-3\">\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {proj.tech.map((t, i) => (\n                    <span key={i} className=\"font-mono text-[9px] text-zinc-400 bg-zinc-950 border border-zinc-800/80 px-2 py-0.5 rounded\">\n                      {t}\n                    </span>\n                  ))}\n                </div>\n                <div className=\"flex items-center space-x-1.5 text-zinc-500 font-mono text-[10px]\">\n                  <Radio className=\"w-3.5 h-3.5 text-emerald-500\" />\n                  <span>METRIC: {proj.stats}</span>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </motion.div>\n\n      {/* The Crucial Paradigm Transition Shift Visual */}\n      <motion.div variants={itemVariants} className=\"bg-zinc-900/20 border border-zinc-800/80 p-6 rounded-2xl md:p-8 space-y-6\">\n        <h3 className=\"font-sans font-bold text-xl text-neutral-100 flex items-center space-x-2\">\n          <Award className=\"w-5 h-5 text-zinc-400\" />\n          <span>Strategic Trajectory Shift</span>\n        </h3>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-12 gap-6 items-center\">\n          <div className=\"md:col-span-5 space-y-2\">\n            <span className=\"font-mono text-[10px] text-red-400 tracking-wider block uppercase\">Yesterday (The Old Ceiling)</span>\n            <h4 className=\"font-sans font-bold text-lg text-zinc-200\">Workflow Automation & Simple SaaS</h4>\n            <p className=\"font-sans text-xs text-zinc-400 leading-relaxed\">\n              Standard SaaS models, customer support bots, basic CRUD platforms, and simple workflow triggers. Building wrappers that simply pipe text from A to B.\n            </p>\n          </div>\n\n          <div className=\"md:col-span-2 flex flex-col items-center justify-center py-2\">\n            <span className=\"font-mono text-zinc-500 text-xs hidden md:block\">SHIFT</span>\n            <div className=\"w-8 h-8 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center text-zinc-300 font-bold my-1 max-md:rotate-90\">\n              \342\206\222\n            </div>\n            <span className=\"font-mono text-emerald-400 text-xs tracking-wider font-bold\">INTELLIGENCE</span>\n          </div>\n\n          <div className=\"md:col-span-5 space-y-2 text-right max-md:text-left\">\n            <span className=\"font-mono text-[10px] text-emerald-400 tracking-wider block uppercase\">Future Core Vector</span>\n            <h4 className=\"font-sans font-bold text-lg text-zinc-100\">Foundational Intelligence Infrastructure</h4>\n            <p className=\"font-sans text-xs text-zinc-400 leading-relaxed\">\n              World models, multi-agent simulation frameworks, corporate intelligence engines, and generative compilers that construct zero-bug structural code bases from mathematical systems designs.\n            </p>\n          </div>\n        </div>\n\n        <div className=\"bg-zinc-950/80 border border-zinc-800/80 p-4 rounded-xl text-center\">\n          <span className=\"font-sans text-xs text-zinc-300 font-medium\">\n            &ldquo;You\342\200\231re moving toward a platform category creator \342\200\224 building the fundamental layers others construct upon.&rdquo;\n          </span>\n        </div>\n      </motion.div>\n    </motion.div>\n  );\n}\n"
    }
