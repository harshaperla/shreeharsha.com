        lines {
          text: "    intro: \"\340\262\244\340\262\202\340\262\244\340\263\215\340\262\260\340\262\234\340\263\215\340\262\236\340\262\276\340\262\250\340\262\265\340\263\201 \340\262\207\340\262\202\340\262\246\340\263\201 \340\262\271\340\263\212\340\262\270 \340\262\216\340\262\244\340\263\215\340\262\244\340\262\260\340\262\227\340\262\263\340\262\250\340\263\215\340\262\250\340\263\201 \340\262\244\340\262\262\340\263\201\340\262\252\340\263\201\340\262\244\340\263\215\340\262\244\340\262\277\340\262\246\340\263\206. \340\262\206\340\262\246\340\262\260\340\263\206 \340\262\225\340\263\203\340\262\244\340\262\225 \340\262\254\340\263\201\340\262\246\340\263\215\340\262\247\340\262\277\340\262\256\340\262\244\340\263\215\340\262\244\340\263\206\340\262\257\340\263\201 \340\262\225\340\262\250\340\263\215\340\262\250\340\262\241 \340\262\255\340\262\276\340\262\267\340\263\206\340\262\257\340\262\250\340\263\215\340\262\250\340\263\201 \340\262\225\340\263\207\340\262\265\340\262\262 \340\262\207\340\262\202\340\262\227\340\263\215\340\262\262\340\262\277\340\262\267\340\263\215 \340\262\255\340\262\276\340\262\267\340\263\206\340\262\257 \340\262\222\340\262\202\340\262\246\340\263\201 \340\262\254\340\262\276\340\262\271\340\263\215\340\262\257 \340\262\205\340\262\250\340\263\201\340\262\265\340\262\276\340\262\246\340\262\246\340\262\202\340\262\244\340\263\206 \340\262\227\340\263\215\340\262\260\340\262\271\340\262\277\340\262\270\340\263\201\340\262\244\340\263\215\340\262\244\340\262\246\340\263\206. \340\262\206\340\262\246\340\262\260\340\263\206 \340\262\225\340\262\250\340\263\215\340\262\250\340\262\241\340\262\246 \340\262\222\340\262\263\340\262\234\340\262\227\340\262\244\340\263\215\340\262\244\340\263\201 \340\262\256\340\262\244\340\263\215\340\262\244\340\263\201 \340\262\205\340\262\246\340\262\260 \340\262\244\340\262\276\340\262\260\340\263\215\340\262\225\340\262\277\340\262\225 \340\262\260\340\262\232\340\262\250\340\263\206 \340\262\254\340\262\271\340\262\263 \340\262\265\340\262\277\340\262\266\340\263\207\340\262\267\340\262\265\340\262\276\340\262\246\340\263\201\340\262\246\340\263\201.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    kannadaTitle: \"Kannada Language Tech and Structural Thought Foundations\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    content: `### \340\262\255\340\262\276\340\262\267\340\263\206 \340\262\205\340\262\202\340\262\246\340\262\260\340\263\206 \340\262\225\340\263\207\340\262\265\340\262\262 \340\262\252\340\262\246\340\262\227\340\262\263\340\262\262\340\263\215\340\262\262"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "\340\262\250\340\262\276\340\262\265\340\263\201 \340\262\225\340\263\203\340\262\244\340\262\225 \340\262\254\340\263\201\340\262\246\340\263\215\340\262\247\340\262\277\340\262\256\340\262\244\340\263\215\340\262\244\340\263\206\340\262\257\340\262\250\340\263\215\340\262\250\340\263\201 \340\262\250\340\262\256\340\263\215\340\262\256 \340\262\246\340\263\210\340\262\250\340\262\202\340\262\246\340\262\277\340\262\250 \340\262\234\340\263\200\340\262\265\340\262\250\340\262\225\340\263\215\340\262\225\340\263\206 \340\262\244\340\262\260\340\262\262\340\263\201 \340\262\271\340\263\206\340\262\243\340\262\227\340\262\276\340\262\241\340\263\201\340\262\244\340\263\215\340\262\244\340\262\277\340\262\246\340\263\215\340\262\246\340\263\207\340\262\265\340\263\206. \340\262\250\340\262\256\340\262\227\340\263\206 \340\262\271\340\263\206\340\262\232\340\263\215\340\262\232\340\262\276\340\262\227\340\262\277 \340\262\270\340\262\277\340\262\227\340\263\201\340\262\244\340\263\215\340\262\244\340\262\277\340\262\260\340\263\201\340\262\265\340\263\201\340\262\246\340\263\201 \340\262\207\340\262\202\340\262\227\340\263\215\340\262\262\340\262\277\340\262\267\340\263\215 \340\262\255\340\262\276\340\262\267\340\263\206\340\262\257 \340\262\250\340\263\207\340\262\260 \340\262\255\340\262\276\340\262\267\340\262\276\340\262\202\340\262\244\340\262\260. \340\262\206\340\262\246\340\262\260\340\263\206 \340\262\225\340\262\250\340\263\215\340\262\250\340\262\241\340\262\246 \340\262\265\340\262\277\340\262\255\340\262\225\340\263\215\340\262\244\340\262\277 \340\262\252\340\263\215\340\262\260\340\262\244\340\263\215\340\262\257\340\262\257\340\262\227\340\262\263\340\263\201, \340\262\265\340\262\276\340\262\225\340\263\215\340\262\257 \340\262\265\340\262\277\340\262\250\340\263\215\340\262\257\340\262\276\340\262\270 \340\262\256\340\262\244\340\263\215\340\262\244\340\263\201 \340\262\252\340\262\246 \340\262\234\340\263\213\340\262\241\340\262\243\340\263\206\340\262\227\340\262\263 \340\262\271\340\262\277\340\262\202\340\262\246\340\263\206 \340\262\222\340\262\202\340\262\246\340\263\201 \340\262\205\340\262\227\340\262\276\340\262\247\340\262\265\340\262\276\340\262\246 \340\262\250\340\262\277\340\262\260\340\263\215\340\262\246\340\262\277\340\262\267\340\263\215\340\262\237\340\262\244\340\263\206 \340\262\207\340\262\246\340\263\206."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
