        lines {
          text: "\340\262\207\340\262\246\340\263\201 \340\262\250\340\262\256\340\263\215\340\262\256 \'\340\262\265\340\262\277\340\262\266\340\263\215\340\262\265 \340\262\256\340\262\276\340\262\246\340\262\260\340\262\277\340\262\227\340\262\263\340\262\250\340\263\215\340\262\250\340\263\201\' (World Models) \340\262\250\340\263\206\340\262\250\340\262\252\340\262\277\340\262\270\340\263\201\340\262\244\340\263\215\340\262\244\340\262\246\340\263\206. \340\262\250\340\262\256\340\263\215\340\262\256 \340\262\255\340\262\265\340\262\277\340\262\267\340\263\215\340\262\257\340\262\246 \340\262\212\340\262\271\340\263\206\340\262\227\340\262\263\340\263\201 \340\262\270\340\263\200\340\262\256\340\262\277\340\262\244\340\262\265\340\262\276\340\262\227\340\262\277\340\262\246\340\263\215\340\262\246\340\262\276\340\262\227 \340\262\250\340\262\276\340\262\265\340\263\201 \340\262\252\340\263\215\340\262\260\340\262\244\340\262\277 \340\262\271\340\263\206\340\262\234\340\263\215\340\262\234\340\263\206\340\262\257\340\262\250\340\263\215\340\262\250\340\263\201 \340\262\234\340\262\276\340\262\227\340\262\260\340\263\202\340\262\225\340\262\244\340\263\206\340\262\257\340\262\277\340\262\202\340\262\246 \340\262\207\340\262\241\340\262\254\340\263\207\340\262\225\340\263\201. \340\262\270\340\262\277\340\262\270\340\263\215\340\262\237\340\262\256\340\263\215 \340\262\222\340\262\263\340\262\271\340\262\260\340\262\277\340\262\265\340\262\250\340\263\215\340\262\250\340\263\201 \340\262\244\340\262\225\340\263\215\340\262\267\340\262\243 \340\262\244\340\262\225\340\263\215\340\262\267\340\262\243 \340\262\227\340\263\215\340\262\260\340\262\271\340\262\277\340\262\270\340\262\277 \340\262\270\340\263\215\340\262\252\340\262\202\340\262\246\340\262\277\340\262\270\340\262\254\340\263\207\340\262\225\340\263\201. \340\262\271\340\263\206\340\262\234\340\263\215\340\262\234\340\263\206\340\262\257\340\262\277\340\262\241\340\263\201\340\262\265\340\263\201\340\262\246\340\263\207 \340\262\222\340\262\202\340\262\246\340\263\201 \340\262\225\340\262\262\340\262\277\340\262\225\340\263\206.`"
