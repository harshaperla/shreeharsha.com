      original_chunk {
        target_content: "              {/* Slider Controls */}\n              <div className=\"flex bg-zinc-950 p-1 border border-zinc-800 rounded-xl w-full md:w-auto\">\n                <button\n                  onClick={() => handleTabChange(\'tech\')}\n                  className={`flex-1 md:flex-none px-4 py-2 rounded-lg font-sans text-xs font-semibold tracking-wider uppercase transition-all ${\n                    selectedType === \'tech\'\n                      ? \'bg-zinc-100 text-zinc-950 shadow-md\'\n                      : \'text-zinc-400 hover:text-zinc-200\'\n                  }`}\n                  id=\"tab-select-tech\"\n                >\n                  Tech\n                </button>\n                <button\n                  onClick={() => handleTabChange(\'kannada\')}\n                  className={`flex-1 md:flex-none px-4 py-2 rounded-lg font-sans text-xs font-semibold tracking-wider uppercase transition-all ${\n                    selectedType === \'kannada\'\n                      ? \'bg-zinc-100 text-zinc-950 shadow-md\'\n                      : \'text-zinc-400 hover:text-zinc-200\'\n                  }`}\n                  id=\"tab-select-kannada\"\n                >\n                  \340\262\225\340\262\250\340\263\215\340\262\250\340\262\241\n                </button>\n                <button\n                  onClick={() => handleTabChange(\'travel\')}\n                  className={`flex-1 md:flex-none px-4 py-2 rounded-lg font-sans text-xs font-semibold tracking-wider uppercase transition-all ${\n                    selectedType === \'travel\'\n                      ? \'bg-zinc-100 text-zinc-950 shadow-md\'\n                      : \'text-zinc-400 hover:text-zinc-200\'\n                  }`}\n                  id=\"tab-select-travel\"\n                >\n                  Travel\n                </button>\n              </div>\n            </div>\n\n            {/* Controls Bar: Search & Tag Filters */}\n            <div className=\"grid grid-cols-1 md:grid-cols-12 gap-4 items-center\">\n              {/* Search */}\n              <div className=\"md:col-span-5 relative\">\n                <Search className=\"w-4 h-4 text-zinc-500 absolute left-3 top-3.5\" />\n                <input\n                  type=\"text\"\n                  placeholder={`Search in ${selectedType === \'kannada\' ? \'\340\262\225\340\262\250\340\263\215\340\262\250\340\262\241 \340\262\254\340\263\215\340\262\262\340\262\276\340\262\227\340\263\215\' : selectedType === \'tech\' ? \'tech tags\' : \'travel regions\'}...`}\n                  value={searchQuery}\n                  onChange={(e) => setSearchQuery(e.target.value)}\n                  className=\"w-full bg-zinc-900 border border-zinc-800 rounded-lg pl-10 pr-4 py-2.5 font-sans text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-zinc-700 transition-colors\"\n                  id=\"blog-search-input\"\n                />\n              </div>\n\n              {/* Dynamically Populated Tags list */}\n              <div className=\"md:col-span-7 flex flex-wrap gap-2 items-center\">\n                <span className=\"font-mono text-[10px] text-zinc-500 uppercase tracking-widest mr-1\">Filter Tags:</span>\n                <button\n                  onClick={() => setSelectedTag(null)}\n                  className={`px-3 py-1 rounded-full font-mono text-[10px] transition-all cursor-pointer ${\n                    selectedTag === null\n                      ? \'bg-zinc-200 text-zinc-950\'\n                      : \'bg-zinc-900 text-zinc-400 hover:bg-zinc-850 hover:text-zinc-200 border border-zinc-800\'\n                  }`}\n                  id=\"tag-filter-all\"\n                >\n                  All\n                </button>\n                {availableTags.map((tag) => (\n                  <button\n                    key={tag}\n                    onClick={() => setSelectedTag(tag)}\n                    className={`px-3 py-1 rounded-ful