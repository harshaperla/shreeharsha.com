        }
        lines {
          text: "    tags: [\"\340\262\265\340\262\277\340\262\250\340\263\215\340\262\257\340\262\276\340\262\270\", \"\340\262\225\340\262\250\340\263\215\340\262\250\340\262\241\", \"\340\262\225\340\263\203\340\262\244\340\262\225 \340\262\254\340\263\201\340\262\246\340\263\215\340\262\247\340\262\277\340\262\256\340\262\244\340\263\215\340\262\244\340\263\206\"],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
