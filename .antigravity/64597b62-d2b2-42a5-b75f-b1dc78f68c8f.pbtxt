  file_change {
    absolute_path_uri: "file:///src/components/ProfileSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { motion } from \'motion/react\';\nimport { \n  Shield, Cpu, RefreshCw, ChevronRight, Layers, Award, Radio, \n  ChefHat, Tv, Sparkles, Users, Briefcase, Building2, Play, Terminal, \n  ArrowRight, Workflow, ExternalLink, HardDrive, CheckCircle2, AlertTriangle, \n  Settings, PlayCircle, Eye, Network, Code2\n} from \'lucide-react\';\nimport { \n  SHREEHARSHA_BIO, \n  SYSTEM_MINDSETS, \n  PROJECTS_DATABASE, \n  ROOTENT_COMPANY, \n  PERSONAL_SECTIONS \n} from \'../data\';\n\ninterface ProfileSectionProps {\n  onNavigateToBlogs: (type: string) => void;\n  onNavigateToContact: () => void;\n}\n\nexport default function ProfileSection({ onNavigateToBlogs, onNavigateToContact }: ProfileSectionProps) {\n  // Simulator State for \"The Builder\'s Paradigm\"\n  const [paradigmMode, setParadigmMode] = useState<\'deterministic\' | \'heuristic\'>(\'deterministic\');\n  const [cycleCount, setCycleCount] = useState<number>(1048);\n  const [logs, setLogs] = useState<string[]>([\n    \"INIT // Kernel loader success\",\n    \"SYS  // System Architecture validated\",\n    \"INFO // Schema meta-compiler primed. Awaiting instruction.\"\n  ]);\n  const [activeCycle, setActiveCycle] = useState<boolean>(false);\n\n  const runSimulationCycle = () => {\n    setActiveCycle(true);\n    setCycleCount(prev => prev + 1);\n    \n    if (paradigmMode === \'deterministic\') {\n      const determinisicSteps = [\n        [\"PARSER // Consuming entity constraint system spec...\", \"PARSER // Relational cardinality matrices built.\"],\n        [\"AST_CHECK // Running relational compiler loop...\", \"AST_CHECK // 0 semantic errors, strict models locked.\"],\n        [\"SYNTHESIS // Materializing optimized Postgres types...\", \"SUCCESS // Secure Admin Panels compiled in 314ms.\"]\n      ];\n      const cycleIndex = cycleCount % determinisicSteps.length;\n      const selectedLogs = determinisicSteps[cycleIndex];\n      \n      setTimeout(() => {\n        setLogs(prev => [...prev, ...selectedLogs].slice(-7));\n        setActiveCycle(false);\n      }, 350);\n    } else {\n      const heuristicSteps = [\n        [\"LLM_PROMPT // Pipelining text instructions...\", \"LLM_PROMPT // Temperature set to 0.7. Streaming output.\"],\n        [\"GEN_WIDGET // Writing raw unvalidated JSX templates...\", \"WARN_DRIFT // State mismatch on parent re-render!\"],\n        [\"CRITICAL  // Uncaught Type Error: undefined is not an object. Halted.\"]\n      ];\n      const cycleIndex = cycleCount % heuristicSteps.length;\n      const selectedLogs = heuristicSteps[cycleIndex];\n      \n      setTimeout(() => {\n        setLogs(prev => [...prev, ...selectedLogs].slice(-7));\n        setActiveCycle(false);\n      }, 350);\n    }\n  };\n\n  const toggleParadigmMode = (mode: \'deterministic\' | \'heuristic\') => {\n    setParadigmMode(mode);\n    setLogs(mode === \'deterministic\' ? [\n      `MODE // Initialized Mode: DETERMINISTIC (Production Platform)`,\n      \"SYS  // Root engine constraints loaded successfully.\",\n      \"READY // Awaiting compiler simulation trigger.\"\n    ] : [\n      `MODE // Switched to HEURISTIC (Model Wrappers / Fragile UI)`,\n      \"SYS  // Prompt tokens piping, direct UI writing active.\",\n      \"WARN // Non-deterministic runtime drifts might form.\"\n    ]);\n  };\n\n  // Stagger animation helpers\n  const containerVariants = {\n    hidden: { opacity: 0 },\n    show: {\n      opacity: 1,\n      transition: {\n        staggerChildren: 0.1,\n      },\n    },\n  };\n\n  const itemVariants = {\n    hidden: { opacity: 0, y: 15 },\n    show: { opacity: 1, y: 0, transition: { type: \'spring\', stiffness: 100 } },\n  };\n\n  return (\n    <motion.div\n      variants={containerVariants}\n      initial=\"hidden\"\n      animate=\"show\"\n      className=\"space-y-16 max-w-6xl mx-auto px-4 py-8 md:py-12\"\n      id=\"profile-section-container\"\n    >\n      {/* 2-Column Hero Structure */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        {/* Bio Highlights / Left Column */}\n        <motion.div variants={itemVariants} className=\"lg:col-span-7 space-y-6\">\n          <div className=\"inline-flex items-center space-x-2 bg-zinc-900 border border-zinc-800/80 px-3.5 py-1.5 rounded-full select-none\">\n            <span className=\"w-2 h-2 bg-emerald-400 rounded-full animate-pulse\"></span>\n            <span className=\"font-mono text-[10px] text-zinc-400 tracking-wider uppercase\">Active Operator Node</span>\n          </div>\n\n          <h1 className=\"font-sans font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-[1.1]\">\n            I&apos;m <span className=\"text-zinc-100 font-mono tracking-tight font-black\">{SHREEHARSHA_BIO.name}</span>.\n          </h1>\n\n          <p className=\"font-sans font-medium text-xl sm:text-2xl text-zinc-300 leading-relaxed max-w-2xl italic border-l-2 border-emerald-500/80 pl-4\">\n            &ldquo;{SHREEHARSHA_BIO.tagline}&rdquo;\n          </p>\n\n          <p className=\"font-sans text-base text-zinc-400 leading-relaxed max-w-2xl\">\n            {SHREEHARSHA_BIO.philosophy}\n          </p>\n\n          <div className=\"flex flex-wrap gap-4 pt-2\">\n            <button\n              onClick={onNavigateToContact}\n              className=\"bg-zinc-100 text-zinc-950 font-sans font-bold text-xs uppercase tracking-wider px-6 py-3.5 rounded-lg hover:bg-white hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center space-x-2 cursor-pointer shadow-lg shadow-emerald-900/10\"\n              id=\"hero-contact-btn\"\n            >\n              <span>Initialize Connection</span>\n              <ChevronRight className=\"w-4 h-4\" />\n            </button>\n            <button\n              onClick={() => onNavigateToBlogs(\'tech\')}\n              className=\"bg-zinc-900/80 text-zinc-300 border border-zinc-800 font-sans font-bold text-xs uppercase tracking-wider px-6 py-3.5 rounded-lg hover:text-white hover:bg-zinc-800/60 transition-all cursor-pointer\"\n              id=\"hero-tech-blog-btn\"\n            >\n              Examine Logbook (Blogs)\n            </button>\n          </div>\n        </motion.div>\n\n        {/* Builder Mindset Interactive Card / Right Column */}\n        <motion.div variants={itemVariants} className=\"lg:col-span-5\">\n          <div className=\"bg-gradient-to-br from-zinc-900 to-zinc-950 border border-zinc-800/95 p-6 md:p-8 rounded-2xl relative overflow-hidden shadow-2xl\">\n            {/* Visual background grid */}\n            <div className=\"absolute inset-0 bg-[linear-gradient(to_right,#2a2a2d_1px,transparent_1px),linear-gradient(to_bottom,#2a2a2d_1px,transparent_1px)] bg-[size:3rem_3rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_80%,transparent_100%)] opacity-35 pointer-events-none\" />\n\n            <div className=\"relative z-10 space-y-5\">\n              <div className=\"flex justify-between items-center border-b border-zinc-800/80 pb-3\">\n                <h3 className=\"font-sans font-bold text-md text-white flex items-center space-x-2\">\n                  <Terminal className=\"w-4.5 h-4.5 text-emerald-400\" />\n                  <span>The Builder&apos;s Paradigm</span>\n                </h3>\n                <span className=\"font-mono text-[9px] text-zinc-500 uppercase tracking-widest bg-zinc-950 px-2 py-0.5 rounded border border-zinc-900\">\n                  Interactive Simulator\n                </span>\n              </div>\n\n              {/* Paradigm Selector Buttons */}\n              <div className=\"grid grid-cols-2 gap-2 bg-zinc-950 p-1 rounded-lg border border-zinc-900\">\n                <button\n                  onClick={() => toggleParadigmMode(\'deterministic\')}\n                  className={`font-mono text-[10px] py-1.5 rounded transition-all cursor-pointer text-center ${\n                    paradigmMode === \'deterministic\'\n                      ? \'bg-zinc-900 text-emerald-400 border border-zinc-850 font-semibold\'\n                      : \'text-zinc-500 hover:text-zinc-300\'\n                  }`}\n                >\n                  DETERMINISTIC\n                </button>\n                <button\n                  onClick={() => toggleParadigmMode(\'heuristic\')}\n                  className={`font-mono text-[10px] py-1.5 rounded transition-all cursor-pointer text-center ${\n                    paradigmMode === \'heuristic\'\n                      ? \'bg-zinc-900 text-amber-500 border border-zinc-850 font-semibold\'\n                      : \'text-zinc-500 hover:text-zinc-300\'\n                  }`}\n                >\n                  FUZZY HEURISTICS\n                </button>\n              </div>\n\n              {/* Dynamic Readouts based on selection */}\n              <div className=\"space-y-2.5 font-mono text-[11px] text-zinc-400 bg-zinc-950/40 p-4 border border-zinc-900/65 rounded-xl\">\n                <div className=\"flex justify-between py-0.5 border-b border-zinc-950\">\n                  <span className=\"text-zinc-500\">OPERATIONAL INTENT</span>\n                  <span className={paradigmMode === \'deterministic\' ? \'text-emerald-400 font-semibold\' : \'text-amber-500\'}>\n                    {paradigmMode === \'deterministic\' ? \'ARCHITECTURE-FIRST\' : \'UI WRAPPER SLOP\'}\n                  </span>\n                </div>\n                <div className=\"flex justify-between py-0.5 border-b border-zinc-950\">\n                  <span className=\"text-zinc-500\">SYSTEM COUPLING</span>\n                  <span className=\"text-zinc-200\">\n                    {paradigmMode === \'deterministic\' ? \'STRICT SCHEMAS & STATE\' : \'MUTABLE HEURISTICS\'}\n                  </span>\n                </div>\n                <div className=\"flex justify-between py-0.5 border-b border-zinc-950\">\n                  <span className=\"text-zinc-500\">CYCLES RUN</span>\n                  <span className=\"text-zinc-400\">{cycleCount}</span>\n                </div>\n              </div>\n\n              {/* Terminal Logs Simulation Console */}\n              <div className=\"bg-zinc-950 font-mono rounded-xl p-3 border border-zinc-900 space-y-1 text-[10.5px] leading-relaxed relative min-h-[110px] flex flex-col justify-end\">\n                <span className=\"absolute top-2 right-2 flex h-2 w-2\">\n                  <span className={`animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 ${activeCycle ? \'bg-sky-400\' : \'bg-emerald-400\'}`}></span>\n                  <span className={`relative inline-flex rounded-full h-2 w-2 ${activeCycle ? \'bg-sky-500\' : \'bg-emerald-500\'}`}></span>\n                </span>\n                \n                <div className=\"flex-1 opacity-80 text-zinc-500 flex flex-col justify-end space-y-0.5 select-none\">\n                  {logs.map((log, idx) => (\n                    <div key={idx} className=\"truncate\">\n                      <span className=\"text-zinc-650\">&gt; </span>\n                      {log.startsWith(\"SUCCESS\") ? (\n                        <span className=\"text-emerald-400\">{log}</span>\n                      ) : log.startsWith(\"WARN\") ? (\n                        <span className=\"text-amber-400\">{log}</span>\n                      ) : log.startsWith(\"CRITICAL\") ? (\n                        <span className=\"text-rose-500 font-semibold\">{log}</span>\n                      ) : (\n                        <span>{log}</span>\n                      )}\n                    </div>\n                  ))}\n                </div>\n              </div>\n\n              {/* Action Button to run simulator */}\n              <button\n                disabled={activeCycle}\n                onClick={runSimulationCycle}\n                className=\"w-full bg-zinc-900 border border-zinc-800 py-2.5 rounded-lg font-mono text-[11px] font-bold text-zinc-200 tracking-wider uppercase hover:text-white hover:bg-zinc-850 hover:border-zinc-700 active:scale-[0.99] transition-all cursor-pointer flex items-center justify-center space-x-2\"\n              >\n                {activeCycle ? (\n                  <span>PROCESSING CYCLE...</span>\n                ) : (\n                  <>\n                    <Play className=\"w-3.5 h-3.5 text-zinc-400\" />\n                    <span>Run Synthesis Cycle</span>\n                  </>\n                )}\n              </button>\n            </div>\n          </div>\n        </motion.div>\n      </div>\n\n      {/* Rootent Company Focus Section */}\n      <motion.div variants={itemVariants} className=\"space-y-6 border-t border-zinc-900 pt-10\">\n        <div className=\"flex flex-col md:flex-row justify-between items-start md:items-end gap-2\">\n          <div>\n            <div className=\"inline-flex items-center space-x-1.5 bg-emerald-950/40 border border-emerald-900/60 px-2.5 py-0.5 rounded text-emerald-400 font-mono text-[9px] tracking-wider uppercase mb-1\">\n              <Building2 className=\"w-3 h-3\" />\n              <span>Incorporated Venture</span>\n            </div>\n            <h2 className=\"font-sans font-bold text-3xl text-white tracking-tight\">\n              {ROOTENT_COMPANY.name}\n            </h2>\n            <p className=\"font-sans text-sm text-zinc-400 max-w-2xl mt-1\">\n              My flagship boutique software operations and high-assurance developer tooling studio.\n            </p>\n          </div>\n          <div className=\"font-mono text-xs text-zinc-500 bg-zinc-900 px-3 py-1.5 rounded-lg border border-zinc-800\">\n            {ROOTENT_COMPANY.role} \342\200\242 {ROOTENT_COMPANY.timeline}\n          </div>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch mt-4\">\n          {/* Company Narrative & Focus Areas */}\n          <div className=\"lg:col-span-7 flex flex-col justify-between space-y-6\">\n            <div className=\"bg-zinc-900/30 border border-zinc-850 p-6 rounded-2xl relative overflow-hidden flex-1 flex flex-col justify-center\">\n              <p className=\"font-sans text-zinc-300 text-md leading-relaxed\">\n                {ROOTENT_COMPANY.description}\n              </p>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n              {ROOTENT_COMPANY.focusAreas.map((area, idx) => (\n                <div key={idx} className=\"bg-zinc-900/10 border border-zinc-900 p-4 rounded-xl space-y-1\">\n                  <span className=\"font-mono text-[10px] text-zinc-500 uppercase tracking-widest block\">Focus {idx+1}</span>\n                  <h4 className=\"font-sans font-bold text-sm text-zinc-200\">{area.title}</h4>\n                  <p className=\"font-sans text-xs text-zinc-400 leading-normal\">{area.desc}</p>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Core Metrics & SVG Flowchart */}\n          <div className=\"lg:col-span-5 flex flex-col justify-between bg-zinc-900/40 border border-zinc-800 p-6 rounded-2xl space-y-6\">\n            <h4 className=\"font-sans font-bold text-xs uppercase text-zinc-400 tracking-wider border-b border-zinc-800/80 pb-2 flex items-center space-x-2\">\n              <Workflow className=\"w-4 h-4 text-emerald-400\" />\n              <span>Continuous Synthesis Pipeline Overlay</span>\n            </h4>\n\n            {/* Custom high-craft representation of the Rootent operational model */}\n            <div className=\"bg-zinc-950 rounded-xl p-4 border border-zinc-900 font-mono text-[9.5px] text-zinc-400 flex flex-col justify-center space-y-3 shadow-inner\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-zinc-500\">[1] ER SPECIFICATION</span>\n                <span className=\"text-zinc-650\">----- yaml -----</span>\n              </div>\n              \n              <div className=\"flex justify-center flex-col items-center py-1\">\n                <div className=\"w-0.5 h-4 bg-zinc-800\" />\n                <div className=\"bg-zinc-900 text-emerald-400 px-3 py-1 rounded border border-emerald-950 flex items-center space-x-1\">\n                  <Cpu className=\"w-3.5 h-3.5 text-emerald-400 animate-spin opacity-80\" />\n                  <span className=\"font-semibold text-[10px]\">ROOTENT META-COMPILER</span>\n                </div>\n                <div className=\"w-0.5 h-4 bg-zinc-800\" />\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-2 text-center text-[9px] font-mono\">\n                <div className=\"bg-zinc-900/60 p-1.5 border border-zinc-900 rounded\">\n                  <span className=\"text-zinc-400 block font-semibold\">Postgres Relational DB API</span>\n                  <span className=\"text-neutral-500 text-[8px]\">Type-Safe Schema</span>\n                </div>\n                <div className=\"bg-zinc-900/60 p-1.5 border border-zinc-900 rounded\">\n                  <span className=\"text-zinc-400 block font-semibold\">TypeScript Client Panel</span>\n                  <span className=\"text-neutral-500 text-[8px]\">100% Deterministic Code</span>\n                </div>\n              </div>\n\n              <div className=\"border-t border-zinc-900 pt-2 text-[8px] text-center text-zinc-500\">\n                OUTPUT ENTIRELY GUARANTEED BY GRAPH CARDINALITY CHECKS\n              </div>\n            </div>\n\n            {/* Business/Operations Metrics */}\n            <div className=\"grid grid-cols-3 gap-3 text-center border-t border-zinc-850/80 pt-4\">\n              {ROOTENT_COMPANY.stats.map((st, i) => (\n                <div key={i} className=\"space-y-0.5\">\n                  <span className=\"font-mono text-xs text-zinc-500 block uppercase max-md:text-[9px]\">{st.label}</span>\n                  <span className=\"font-mono text-[16px] font-black text-white\">{st.value}</span>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </motion.div>\n\n      {/* Focus & Intersection */}\n      <motion.div variants={itemVariants} className=\"space-y-6 border-t border-zinc-900 pt-10\">\n        <div>\n          <h2 className=\"font-sans font-bold text-2xl text-white tracking-tight\">Foundational Mindsets</h2>\n          <p className=\"font-sans text-sm text-zinc-400\">The architecture principles that prevent UI complexity from structural collapse.</p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          {SYSTEM_MINDSETS.map((mindset, index) => (\n            <div\n              key={index}\n              className=\"bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700/85 p-5 rounded-xl hover:bg-zinc-900/60 transition-all duration-150 space-y-3\"\n            >\n              <div className=\"flex items-center space-x-3\">\n                <div className=\"bg-zinc-900 p-2.5 rounded-lg border border-zinc-850\">\n                  {index === 0 && <Shield className=\"w-5 h-5 text-sky-400\" />}\n                  {index === 1 && <Cpu className=\"w-5 h-5 text-amber-500\" />}\n                  {index === 2 && <RefreshCw className=\"w-5 h-5 text-emerald-400\" />}\n                </div>\n                <span className=\"font-mono text-xs text-zinc-500 uppercase tracking-widest\">{mindset.label}</span>\n              </div>\n              <h4 className=\"font-sans font-bold text-base text-zinc-100\">{mindset.value}</h4>\n              <p className=\"font-sans text-xs text-zinc-400 leading-relaxed\">{mindset.description}</p>\n            </div>\n          ))}\n        </div>\n      </motion.div>\n\n      {/* Personal Section: Beyond the Abstraction */}\n      <motion.div variants={itemVariants} className=\"space-y-6 border-t border-zinc-900 pt-10\">\n        <div>\n          <span className=\"font-mono text-xs text-emerald-400 uppercase tracking-widest block font-semibold mb-1\">Human Operability</span>\n          <h2 className=\"font-sans font-bold text-3.5xl text-white tracking-tight\">Beyond the Abstraction</h2>\n          <p className=\"font-sans text-sm text-zinc-400\">Where the systemic mindset exits the keyboard and structures the physical layer of living.</p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          {/* Cooking Box */}\n          <div className=\"bg-zinc-900/20 border border-zinc-850 p-6 rounded-2xl hover:border-zinc-700/80 hover:bg-zinc-900/30 transition-all space-y-3 flex flex-col justify-between\">\n            <div className=\"space-y-3\">\n              <div className=\"flex justify-between items-center\">\n                <div className=\"inline-flex items-center space-x-2.5\">\n                  <div className=\"bg-zinc-900 p-2 rounded-lg border border-zinc-800 text-amber-400\">\n                    <ChefHat className=\"w-4.5 h-4.5\" />\n                  </div>\n                  <h4 className=\"font-sans font-bold text-lg text-zinc-100\">{PERSONAL_SECTIONS.cooking.title}</h4>\n                </div>\n                <span className=\"font-mono text-[9px] text-zinc-500 bg-zinc-950 px-2 py-1 rounded border border-zinc-900 uppercase\">\n                  {PERSONAL_SECTIONS.cooking.metric}\n                </span>\n              </div>\n              <p className=\"font-sans text-xs sm:text-sm text-zinc-400 leading-relaxed\">\n                {PERSONAL_SECTIONS.cooking.desc}\n              </p>\n            </div>\n            <div className=\"pt-2 border-t border-zinc-950/60 flex items-center justify-between text-[10px] font-mono text-zinc-500\">\n              <span>PARAMETER: HYDROLOGIC SOURDOUGH DOUGH</span>\n              <span className=\"text-emerald-400\">READY TO BAKE</span>\n            </div>\n          </div>\n\n          {/* Watching Box */}\n          <div className=\"bg-zinc-900/20 border border-zinc-850 p-6 rounded-2xl hover:border-zinc-700/80 hover:bg-zinc-900/30 transition-all space-y-3 flex flex-col justify-between\">\n            <div className=\"space-y-3\">\n              <div className=\"flex justify-between items-center\">\n                <div className=\"inline-flex items-center space-x-2.5\">\n                  <div className=\"bg-zinc-900 p-2 rounded-lg border border-zinc-800 text-sky-400\">\n                    <Tv className=\"w-4.5 h-4.5\" />\n                  </div>\n                  <h4 className=\"font-sans font-bold text-lg text-zinc-100\">{PERSONAL_SECTIONS.watching.title}</h4>\n                </div>\n                <span className=\"font-mono text-[9px] text-zinc-500 bg-zinc-950 px-2 py-1 rounded border border-zinc-900 uppercase\">\n                  {PERSONAL_SECTIONS.watching.metric}\n                </span>\n              </div>\n              <p className=\"font-sans text-xs sm:text-sm text-zinc-400 leading-relaxed\">\n                {PERSONAL_SECTIONS.watching.desc}\n              </p>\n            </div>\n            <div className=\"pt-2 border-t border-zinc-950/60 flex items-center justify-between text-[10px] font-mono text-zinc-500\">\n              <span>ABSTRACTION: NEURAL GHOST NETWORKS</span>\n              <span className=\"text-indigo-400\">SYNCHRONIZED</span>\n            </div>\n          </div>\n\n          {/* Magic Box */}\n          <div className=\"bg-zinc-900/20 border border-zinc-850 p-6 rounded-2xl hover:border-zinc-700/80 hover:bg-zinc-900/30 transition-all space-y-3 flex flex-col justify-between\">\n            <div className=\"space-y-3\">\n              <div className=\"flex justify-between items-center\">\n                <div className=\"inline-flex items-center space-x-2.5\">\n                  <div className=\"bg-zinc-900 p-2 rounded-lg border border-zinc-800 text-violet-400\">\n                    <Sparkles className=\"w-4.5 h-4.5\" />\n                  </div>\n                  <h4 className=\"font-sans font-bold text-lg text-zinc-100\">{PERSONAL_SECTIONS.magic.title}</h4>\n                </div>\n                <span className=\"font-mono text-[9px] text-zinc-500 bg-zinc-950 px-2 py-1 rounded border border-zinc-900 uppercase\">\n                  {PERSONAL_SECTIONS.magic.metric}\n                </span>\n              </div>\n              <p className=\"font-sans text-xs sm:text-sm text-zinc-400 leading-relaxed\">\n                {PERSONAL_SECTIONS.magic.desc}\n              </p>\n            </div>\n            <div className=\"pt-2 border-t border-zinc-950/60 flex items-center justify-between text-[10px] font-mono text-zinc-500\">\n              <span>ALGORITHM: RECURSIVE SHUFFLE PASS</span>\n              <span className=\"text-purple-400\">ZERO LATENCY</span>\n            </div>\n          </div>\n\n          {/* Social Box */}\n          <div className=\"bg-zinc-900/20 border border-zinc-850 p-6 rounded-2xl hover:border-zinc-700/80 hover:bg-zinc-900/30 transition-all space-y-3 flex flex-col justify-between\">\n            <div className=\"space-y-3\">\n              <div className=\"flex justify-between items-center\">\n                <div className=\"inline-flex items-center space-x-2.5\">\n                  <div className=\"bg-zinc-900 p-2 rounded-lg border border-zinc-800 text-emerald-400\">\n                    <Users className=\"w-4.5 h-4.5\" />\n                  </div>\n                  <h4 className=\"font-sans font-bold text-lg text-zinc-100\">{PERSONAL_SECTIONS.social.title}</h4>\n                </div>\n                <span className=\"font-mono text-[9px] text-zinc-500 bg-zinc-950 px-2 py-1 rounded border border-zinc-900 uppercase\">\n                  {PERSONAL_SECTIONS.social.metric}\n                </span>\n              </div>\n              <p className=\"font-sans text-xs sm:text-sm text-zinc-400 leading-relaxed\">\n                {PERSONAL_SECTIONS.social.desc}\n              </p>\n            </div>\n            <div className=\"pt-2 border-t border-zinc-950/60 flex items-center justify-between text-[10px] font-mono text-zinc-500\">\n              <span>LOCAL HUB: BENGALURU OPERATOR MAPS</span>\n              <span className=\"text-emerald-400\">ACTIVE CONTRIB</span>\n            </div>\n          </div>\n        </div>\n      </motion.div>\n\n      {/* Production Case Studies Section (Real Products) */}\n      <motion.div variants={itemVariants} className=\"space-y-6 border-t border-zinc-900 pt-10\">\n        <div>\n          <h2 className=\"font-sans font-bold text-2xl text-white tracking-tight\">Engineered Architectures</h2>\n          <p className=\"font-sans text-sm text-zinc-400\">Core operational software products I have designed and deployed representing systemic logic over quick tricks.</p>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n          {PROJECTS_DATABASE.map((proj) => (\n            <div\n              key={proj.id}\n              className=\"bg-zinc-900/30 border border-zinc-850 hover:border-zinc-750 p-6 rounded-xl flex flex-col justify-between hover:bg-zinc-900/50 transition-all group\"\n            >\n              <div className=\"space-y-4\">\n                <div className=\"flex justify-between items-start\">\n                  <div>\n                    <span className=\"font-mono text-[10px] text-zinc-500 uppercase tracking-widest block\">{proj.type}</span>\n                    <h4 className=\"font-sans font-bold text-lg text-white group-hover:text-zinc-100 transition-colors mt-1\">\n                      {proj.title}\n                    </h4>\n                  </div>\n                  <span className=\"font-sans text-xs font-semibold px-2.5 py-1 rounded bg-zinc-800 text-zinc-300\">\n                    {proj.role}\n                  </span>\n                </div>\n\n                <p className=\"font-sans text-xs text-zinc-400 leading-relaxed line-clamp-4\">\n                  {proj.description}\n                </p>\n              </div>\n\n              <div className=\"mt-6 pt-4 border-t border-zinc-900 space-y-3\">\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {proj.tech.map((t, i) => (\n                    <span key={i} className=\"font-mono text-[9px] text-zinc-400 bg-zinc-950 border border-zinc-850 px-2 py-0.5 rounded\">\n                      {t}\n                    </span>\n                  ))}\n                </div>\n                <div className=\"flex items-center space-x-1.5 text-zinc-500 font-mono text-[10px]\">\n                  <Radio className=\"w-3.5 h-3.5 text-emerald-405 text-emerald-500\" />\n                  <span>METRIC: {proj.stats}</span>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </motion.div>\n\n      {/* The Crucial Paradigm Transition Shift Visual */}\n      <motion.div variants={itemVariants} className=\"bg-zinc-900/20 border border-zinc-855 p-6 rounded-2xl md:p-8 space-y-6\">\n        <h3 className=\"font-sans font-bold text-xl text-neutral-100 flex items-center space-x-2\">\n          <Award className=\"w-5 h-5 text-zinc-400\" />\n          <span>Strategic Trajectory Shift</span>\n        </h3>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-12 gap-6 items-center\">\n          <div className=\"md:col-span-5 space-y-2\">\n            <span className=\"font-mono text-[10px] text-red-400 tracking-wider block uppercase\">Yesterday (The Old Ceiling)</span>\n            <h4 className=\"font-sans font-bold text-lg text-zinc-200\">Workflow Automation & Simple SaaS</h4>\n            <p className=\"font-sans text-xs text-zinc-400 leading-relaxed\">\n              Standard SaaS models, customer support bots, basic CRUD platforms, and simple workflow triggers. Building wrappers that simply pipe text from A to B.\n            </p>\n          </div>\n\n          <div className=\"md:col-span-2 flex flex-col items-center justify-center py-2\">\n            <span className=\"font-mono text-zinc-500 text-xs hidden md:block\">SHIFT</span>\n            <div className=\"w-8 h-8 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center text-zinc-300 font-bold my-1 max-md:rotate-90\">\n              \342\206\222\n            </div>\n            <span className=\"font-mono text-emerald-400 text-xs tracking-wider font-bold\">INTELLIGENCE</span>\n          </div>\n\n          <div className=\"md:col-span-5 space-y-2 text-right max-md:text-left\">\n            <span className=\"font-mono text-[10px] text-emerald-400 tracking-wider block uppercase\">Future Core Vector</span>\n            <h4 className=\"font-sans font-bold text-lg text-zinc-100\">Foundational Intelligence Infrastructure</h4>\n            <p className=\"font-sans text-xs text-zinc-400 leading-relaxed\">\n              World models, multi-agent simulation frameworks, corporate intelligence engines, and generative compilers that construct zero-bug structural code bases from mathematical systems designs.\n            </p>\n          </div>\n        </div>\n\n        <div className=\"bg-zinc-950/80 border border-zinc-800/80 p-4 rounded-xl text-center\">\n          <span className=\"font-sans text-xs text-zinc-300 font-medium\">\n            &ldquo;You\342\200\231re moving toward a platform category creator \342\200\224 building the fundamental layers others construct upon.&rdquo;\n          </span>\n        </div>\n      </motion.div>\n    </motion.div>\n  );\n}\n"
    }
