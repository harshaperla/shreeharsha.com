          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    tags: [\"Western Ghats\", \"Monsoon\", \"Logistics\"],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    location: \"Kudremukh National Park, Karnataka\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
